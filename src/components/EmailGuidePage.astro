---
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import ToolCta from './ToolCta.astro';
import Disclaimer from './Disclaimer.astro';
import { pageByPath } from '../lib/pages';
import { articleJsonLd, faqJsonLd } from '../lib/jsonld';
import type { EmailGuide } from '../data/types';

interface RelatedLink { href: string; label: string }
interface Props { path: string; h1: string; dataset: EmailGuide; related?: RelatedLink[] }
const { path, h1, dataset, related = [] } = Astro.props;
const page = pageByPath(path)!;
---
<Base title={page.title} description={page.description} path={page.path} jsonLd={[articleJsonLd(page), faqJsonLd(dataset.faqs)]}>
  <h1>{h1}</h1>
  {dataset.intro.map((p) => <p class="lede">{p}</p>)}

  {dataset.sections.map((s) => (
    <section>
      <h2>{s.heading}</h2>
      {s.body.map((p) => <p>{p}</p>)}
    </section>
  ))}

  <h2>Templates you can copy</h2>
  <p>Replace the [bracketed] parts with your specifics. The detail from your actual conversation is what makes a template sound like you wrote it — because you did.</p>
  {dataset.templates.map((t) => (
    <div class="card">
      <h3>{t.name}</h3>
      <p class="why">{t.when}</p>
      <pre class="template-body">{`Subject: ${t.subject}\n\n${t.body.join('\n\n')}`}</pre>
    </div>
  ))}

  <h2>Mistakes that weaken the email</h2>
  <ul>
    {dataset.mistakes.map((m) => <li>{m}</li>)}
  </ul>

  {related.length > 0 && (
    <p>
      Keep going: {related.map((r, i) => (
        <span>{i > 0 ? ' · ' : ''}<a href={r.href}>{r.label}</a></span>
      ))}
    </p>
  )}

  <ToolCta />
  <Faq faqs={dataset.faqs} />
  <Disclaimer />
</Base>
