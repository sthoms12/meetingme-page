---
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import QuestionList from './QuestionList.astro';
import ToolCta from './ToolCta.astro';
import Disclaimer from './Disclaimer.astro';
import { pageByPath } from '../lib/pages';
import { articleJsonLd, faqJsonLd } from '../lib/jsonld';
import type { InterviewTypeGuide } from '../data/types';

interface RelatedLink { href: string; label: string }
interface Props { path: string; h1: string; dataset: InterviewTypeGuide; questionsHeading: string; related?: RelatedLink[] }
const { path, h1, dataset, questionsHeading, related = [] } = Astro.props;
const page = pageByPath(path)!;
---
<Base title={page.title} description={page.description} path={page.path} jsonLd={[articleJsonLd(page), faqJsonLd(dataset.faqs)]}>
  <h1>{h1}</h1>
  {dataset.intro.map((p) => <p class="lede">{p}</p>)}

  {dataset.sections.map((s) => (
    <section>
      <h2>{s.heading}</h2>
      {s.body.map((p) => <p>{p}</p>)}
    </section>
  ))}

  <h2>{questionsHeading}</h2>
  <QuestionList questions={dataset.questions} />

  {related.length > 0 && (
    <p>
      Keep going: {related.map((r, i) => (
        <span>{i > 0 ? ' · ' : ''}<a href={r.href}>{r.label}</a></span>
      ))}
    </p>
  )}

  <ToolCta />
  <Faq faqs={dataset.faqs} />
  <Disclaimer />
</Base>
