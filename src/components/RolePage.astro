---
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import QuestionList from './QuestionList.astro';
import AskList from './AskList.astro';
import ToolCta from './ToolCta.astro';
import Disclaimer from './Disclaimer.astro';
import { pageByPath } from '../lib/pages';
import { articleJsonLd, faqJsonLd } from '../lib/jsonld';
import type { RoleDataset } from '../data/types';

interface Props { dataset: RoleDataset }
const { dataset } = Astro.props;
const page = pageByPath(dataset.pagePath)!;
---
<Base title={page.title} description={page.description} path={page.path} jsonLd={[articleJsonLd(page), faqJsonLd(dataset.faqs)]}>
  <h1>{dataset.h1}</h1>
  {dataset.intro.map((p) => <p>{p}</p>)}

  <h2>Questions you will be asked — and how to answer them</h2>
  <QuestionList questions={dataset.questions} />

  <ToolCta role={dataset.slug} />

  <h2>Questions to ask them</h2>
  <p>
    Asking sharp questions is part of the interview — it shows judgment and it protects you from taking the
    wrong job. These are the questions {dataset.roleName.toLowerCase()} candidates should ask before accepting.
  </p>
  <AskList items={dataset.questionsToAsk} />

  {dataset.companion && (
    <div class="card">
      <h3>{dataset.companion.heading}</h3>
      <p>{dataset.companion.text}</p>
      <p><a href={dataset.companion.href}>Read the companion page</a></p>
    </div>
  )}

  <Faq faqs={dataset.faqs} />
  <Disclaimer />
</Base>
