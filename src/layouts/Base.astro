---
import '../styles/global.css';
import { SITE_ORIGIN } from '../lib/pages';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: string[];
  wide?: boolean;
}
const { title, description, path, jsonLd = [], wide = false } = Astro.props;
const canonical = `${SITE_ORIGIN}${path}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="B4WeMeet" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/b4wemeet-icon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1d6f5c" />
    <link rel="alternate" type="text/markdown" href={path === '/' ? '/index.md' : `${path.replace(/\/$/, '')}.md`} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={ld} />)}
    <script defer src="https://glass-portfolio.sthoms105.workers.dev/s.js" data-project="b4wemeet" data-persistence="cookieless"></script>
    <script src="/register-sw.js" defer></script>
  </head>
  <body>
    <div class={`wrap${wide ? ' wide' : ''}`}>
      <header class="site">
        <a class="brand" href="/">B4<span>We</span>Meet</a>
        <nav class="site">
          <a href="/interview-prep/">Prep Pack Builder</a>
          <a href="/how-to-prepare-for-an-interview/">Guide</a>
          <a href="/common-interview-questions/">Questions</a>
          <a href="/interview-prep-checklist/">Checklist</a>
          <a href="/templates/">Templates</a>
          <a href="/privacy/">Privacy</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site">
        <nav>
          <a href="/interview-prep/">Prep Pack Builder</a>
          <a href="/questions-to-ask-in-an-interview/">Questions to Ask</a>
          <a href="/star-method-interview/">STAR Method</a>
          <a href="/tell-me-about-yourself/">Tell Me About Yourself</a>
          <a href="/templates/">Meeting Templates</a>
          <a href="/privacy/">Security &amp; Privacy</a>
        </nav>
        <p>B4WeMeet is a free, private interview prep tool. Everything you prepare is stored only in your browser, on your device — no account, no uploads.</p>
      </footer>
    </div>
  </body>
</html>
