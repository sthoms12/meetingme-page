---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import ToolCta from '../components/ToolCta.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { pageByPath } from '../lib/pages';
import { articleJsonLd, faqJsonLd } from '../lib/jsonld';
import { prepareGuide } from '../data/general';

const page = pageByPath('/how-to-prepare-for-an-interview/')!;
---
<Base title={page.title} description={page.description} path={page.path} jsonLd={[articleJsonLd(page), faqJsonLd(prepareGuide.faqs)]}>
  <h1>How to prepare for an interview</h1>
  <p class="lede">
    Good interviews are rarely improvised. Preparation means knowing what the employer needs, having real
    stories ready for the obvious questions, and removing every logistical surprise — most of it doable in a
    few focused hours spread over the days before.
  </p>
  {prepareGuide.sections.map((s) => (
    <section>
      <h2>{s.heading}</h2>
      {s.body.map((p) => <p>{p}</p>)}
    </section>
  ))}
  <p>
    Keep everything in one place with the <a href="/interview-prep-checklist/">interview prep checklist</a>,
    and work through the <a href="/common-interview-questions/">common questions</a> and
    <a href="/behavioral-interview-questions/">behavioral questions</a> most candidates are asked.
  </p>
  <ToolCta />
  <Faq faqs={prepareGuide.faqs} />
  <Disclaimer />
</Base>
