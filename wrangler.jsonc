{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "meetingme-page",
	"main": "worker/index.ts",
	"compatibility_date": "2025-04-24",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": true
	},
	"observability": {
		"enabled": true
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GlobalDurableObject"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"GlobalDurableObject"
			]
		}
	]
}
